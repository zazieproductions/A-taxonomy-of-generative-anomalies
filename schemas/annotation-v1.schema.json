{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zazieproductions.github.io/A-taxonomy-of-generative-anomalies/schemas/annotation-v1.schema.json",
  "title": "Archive manual annotation bundle",
  "description": "Manual, multi-label classifications with explicit annotation provenance. Taxonomy membership and generation references are checked by the repository validator.",
  "type": "object",
  "required": ["schema_version", "taxonomy_version", "annotations"],
  "properties": {
    "schema_version": {"const": 1},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "annotations": {"type": "array", "items": {"$ref": "#/$defs/annotation"}}
  },
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["quote"],
      "properties": {
        "quote": {"type": "string"},
        "start": {"type": ["integer", "null"], "minimum": 0},
        "end": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "required": ["annotation_id", "generation_id", "labels", "annotator", "rationale", "provenance"],
      "properties": {
        "annotation_id": {"type": "string", "minLength": 1},
        "generation_id": {"type": "string", "minLength": 1},
        "labels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "annotator": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "provenance": {
          "type": "object",
          "required": ["method", "created_at", "status"],
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "created_at": {"type": "string", "minLength": 1},
            "status": {"type": "string", "minLength": 1},
            "source": {"type": ["string", "null"]},
            "tool": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
